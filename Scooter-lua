local function updateButtons()
    local data = {
        {button = airButton, mode = "spin", name = "AIR SPIN"},
        {button = fallButton, mode = "fall", name = "AIR SPIN (FALL)"},
        {button = loopButton, mode = "loop", name = "AIR LOOP"},
    }

    for _, item in ipairs(data) do
        if activeTrick == item.mode then
            item.button.Text = "■ STOP " .. item.name
            item.button.BackgroundColor3 = PURPLE
        else
            item.button.Text = "▶ " .. item.name
            item.button.BackgroundColor3 = PANEL
        end
    end

    if activeTrick then
        statusLabel.Text = "STATUS: " .. string.upper(activeTrick) .. " ON"
        statusLabel.TextColor3 = GREEN
    else
        statusLabel.Text = "STATUS: OFF"
        statusLabel.TextColor3 = MUTED
    end
end

local function getCharacterParts()
    local character = player.Character
    if not character then return nil, nil, nil end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not root or humanoid.Health <= 0 then
        return nil, nil, nil
    end

    return character, humanoid, root
end

local function stopTrick()
    trickToken += 1
    activeTrick = nil
    updateButtons()
end

-- FLOAT WITHOUT JUMPING
local function startTrick(mode)
    if activeTrick == mode then
        stopTrick()
        return
    end

    trickToken += 1
    local myToken = trickToken
    activeTrick = mode
    updateButtons()

    task.spawn(function()
        while activeTrick == mode and trickToken == myToken do
            local character, humanoid, root = getCharacterParts()

            if not character or not humanoid or not root then
                task.wait(0.2)
                continue
            end

            -- Preserve the current position and lift gradually.
            -- No Humanoid.Jump and no Jumping state are used.
            local startPosition = root.Position
            local liftHeight = math.clamp(launchPower * 0.12, 3, 18)
            local floatDuration = 0.45
            local elapsed = 0

            -- Prevent normal gravity from immediately cancelling the lift.
            while elapsed < floatDuration
                and activeTrick == mode
                and trickToken == myToken
                and root.Parent
                and humanoid.Health > 0 do

                local dt = RunService.Heartbeat:Wait()
                elapsed += dt

                local alpha = math.clamp(elapsed / floatDuration, 0, 1)
                local targetPosition = startPosition + Vector3.new(
                    0, liftHeight * alpha, 0
                )

                root.AssemblyLinearVelocity = Vector3.zero
                root.CFrame = CFrame.new(targetPosition) * (
                    root.CFrame - root.Position
                )
            end

            if activeTrick ~= mode or trickToken ~= myToken then
                break
            end

            -- Rotate in place while floating.
            local angle = 0
            local totalAngle = math.rad(360 * spinCount)

            while angle < totalAngle
                and activeTrick == mode
                and trickToken == myToken
                and root.Parent
                and humanoid.Health > 0 do

                local dt = RunService.Heartbeat:Wait()
                angle = math.min(
                    angle + math.rad(spinSpeed) * dt,
                    totalAngle
                )

                local position = root.Position
                local rotation

                if mode == "loop" then
                    rotation = CFrame.Angles(angle, 0, 0)
                else
                    rotation = CFrame.Angles(0, angle, 0)
                end

                root.CFrame = CFrame.new(position) * rotation
                root.AssemblyLinearVelocity = Vector3.zero
            end

            -- Ease back down to the starting height.
            local downStart = root.Position
            local downDuration = 0.35
            elapsed = 0

            while elapsed < downDuration
                and activeTrick == mode
                and trickToken == myToken
                and root.Parent
                and humanoid.Health > 0 do

                local dt = RunService.Heartbeat:Wait()
                elapsed += dt

                local alpha = math.clamp(elapsed / downDuration, 0, 1)
                local targetY = downStart.Y
                    + (startPosition.Y - downStart.Y) * alpha

                local position = Vector3.new(
                    downStart.X, targetY, downStart.Z
                )

                root.CFrame = CFrame.new(position) * (
                    root.CFrame - root.Position
                )
                root.AssemblyLinearVelocity = Vector3.zero
            end

            if activeTrick == mode and trickToken == myToken then
                task.wait(0.1)
            end
        end
    end)
end

