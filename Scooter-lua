-- Character
local function getParts()
    local character = player.Character
    if not character then return end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not root or humanoid.Health <= 0 then
        return
    end

    return character, humanoid, root
end

local function updateButtons()
    local states = {
        {airButton, airLabel, "Air Spin", "air"},
        {fallButton, fallLabel, "Air Spin (Fall)", "fall"},
        {loopButton, loopLabel, "Air Loop", "loop"}
    }

    for _, item in ipairs(states) do
        local button, label, name, mode = item
        local on = activeTrick == mode

        label.Text = name .. (on and "  •  ON" or "  •  OFF")
        button.BackgroundColor3 = on and ACTIVE or BUTTON
        button:SetAttribute("Active", on)
    end

    statusDot.BackgroundColor3 = activeTrick
        and Color3.fromRGB(255, 198, 91)
        or Color3.fromRGB(104, 230, 156)

    statusText.Text = activeTrick
        and "TRICK ACTIVE  •  Press again to stop"
        or "READY  •  Choose a trick"
end

local function stopTrick(message)
    trickToken += 1
    activeTrick = nil

    if activeHumanoid and activeHumanoid.Parent then
        activeHumanoid.AutoRotate = true
    end
    activeHumanoid = nil

    updateButtons()
    if message then notify(message) end
end

local function startTrick(mode)
    -- Pressing the same button again stops the trick.
    if activeTrick == mode then
        stopTrick("Trick stopped")
        return
    end

    -- Cancel any other active trick.
    if activeTrick then
        stopTrick()
    end

    local _, humanoid, root = getParts()
    if not humanoid or not root then
        notify("Character not ready")
        return
    end

    trickToken += 1
    local myToken = trickToken

    activeTrick = mode
    activeHumanoid = humanoid
    humanoid.AutoRotate = false
    updateButtons()
    notify(mode == "loop" and "Air Loop started" or "Trick loop started")

    task.spawn(function()
        while activeTrick == mode and trickToken == myToken do
            local _, currentHumanoid, currentRoot = getParts()
            if not currentHumanoid or not currentRoot then
                break
            end

            -- Start a new jump when grounded.
            if currentHumanoid.FloorMaterial ~= Enum.Material.Air then
                if mode == "fall" then
                    currentRoot.AssemblyLinearVelocity = Vector3.new(
                        currentRoot.AssemblyLinearVelocity.X,
                        jumpPower,
                        currentRoot.AssemblyLinearVelocity.Z
                    )
                else
                    currentHumanoid.Jump = true
                    currentHumanoid:ChangeState(
                        Enum.HumanoidStateType.Jumping
                    )
                end

                -- Give Roblox a moment to register the jump.
                local startWait = os.clock()
                while currentHumanoid.FloorMaterial ~= Enum.Material.Air
                    and os.clock() - startWait < 0.5
                    and activeTrick == mode
                    and trickToken == myToken do
                    RunService.Heartbeat:Wait()
                end
            end

            if activeTrick ~= mode or trickToken ~= myToken then
                break
            end

            local duration = (360 * spinCount) / math.max(spinSpeed, 1)
            local elapsed = 0
            local baseCFrame = currentRoot.CFrame
            local basePosition = currentRoot.Position

            -- Run one rotation sequence.
            while elapsed < duration
                and activeTrick == mode
                and trickToken == myToken do

                local dt = RunService.Heartbeat:Wait()
                if not currentRoot.Parent or currentHumanoid.Health <= 0 then
                    break
                end

                elapsed = math.min(elapsed + dt, duration)
                local angle = math.rad(360 * spinCount)
                    * (elapsed / duration)

                local rotation
                if mode == "loop" then
                    rotation = CFrame.Angles(angle, 0, 0)
                else
                    rotation = CFrame.Angles(0, angle, 0)
                end

                currentRoot.CFrame =
                    CFrame.new(currentRoot.Position)
                    * (baseCFrame - basePosition)
                    * rotation
            end

            if activeTrick ~= mode or trickToken ~= myToken then
                break
            end

            -- Wait for landing before starting the next jump.
            while currentHumanoid.Parent
                and currentHumanoid.Health > 0
                and currentHumanoid.FloorMaterial == Enum.Material.Air
                and activeTrick == mode
                and trickToken == myToken do
                RunService.Heartbeat:Wait()
            end

            if activeTrick == mode and trickToken == myToken then
                task.wait(0.1)
            end
        end

        if trickToken == myToken then
            activeTrick = nil
            if activeHumanoid and activeHumanoid.Parent then
                activeHumanoid.AutoRotate = true
            end
            activeHumanoid = nil
            updateButtons()
            notify("Trick stopped")
        end
    end)
end

