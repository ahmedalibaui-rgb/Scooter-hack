local function makeSlider(text, y, minValue, maxValue, initial, callback)
    local valueLabel = label(panel, text .. ": " .. initial,
        UDim2.new(1, -36, 0, 20), UDim2.fromOffset(18, y), 12, WHITE)

    local bar = Instance.new("TextButton")
    bar.Size = UDim2.new(1, -36, 0, 10)
    bar.Position = UDim2.fromOffset(18, y + 24)
    bar.Text = ""
    bar.AutoButtonColor = false
    bar.BackgroundColor3 = Color3.fromRGB(65, 53, 85)
    bar.BorderSizePixel = 0
    bar.Parent = panel
    corner(bar, 6)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.fromScale(
        (initial - minValue) / (maxValue - minValue), 1
    )
    fill.BackgroundColor3 = PINK
    fill.BorderSizePixel = 0
    fill.Parent = bar
    corner(fill, 6)

    local dragging = false

    local function update(x)
        local ratio = math.clamp(
            (x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1),
            0, 1
        )
        local value = math.floor(
            minValue + ratio * (maxValue - minValue) + 0.5
        )
        fill.Size = UDim2.fromScale(ratio, 1)
        valueLabel.Text = text .. ": " .. value
        callback(value)
    end

    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            update(input.Position.X)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            update(input.Position.X)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

