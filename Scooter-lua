local function playMusic(trackName)
    if musicSound then
        musicSound:Stop()
        musicSound:Destroy()
        musicSound = nil
    end

    local sound = Instance.new("Sound")
    sound.Name = "RZR_Music"
    sound.SoundId = MUSIC[trackName]
    sound.Volume = 0.5
    sound.Looped = true
    sound.Parent = gui
    musicSound = sound

    sound:Play()
end

