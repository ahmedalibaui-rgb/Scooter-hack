local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local gui = Instance.new("ScreenGui")
gui.Name = "AirSpinGUI"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local spinSpeed, jumpPower, spinCount = 1440, 70, 15
local busy, hidden = false, false

local songs = {
    ["1 tap"] = "123272377121190",
    ["Track 2"] = "116873078212017",
    ["Fruity 2.0"] = "102616343336371"
}
local songNames = {"1 tap", "Track 2", "Fruity 2.0"}
local songIndex = 1
local music = Instance.new("Sound")
music.Name = "AirSpinMusic"
music.Volume = 0.5
music.Looped = true
music.SoundId = "rbxassetid://" .. songs[songNames[songIndex]]
music.Parent = gui

local panel = Instance.new("Frame")
panel.Size = UDim2.fromOffset(280, 380)
panel.Position = UDim2.new(0, 25, 0.3, 0)
panel.BackgroundColor3 = Color3.fromRGB(25, 25, 34)
panel.Parent = gui
Instance.new("UICorner", panel).CornerRadius = UDim.new(0, 12)

local function makeButton(text, y, parent)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -20, 0, 34)
    b.Position = UDim2.fromOffset(10, y)
    b.BackgroundColor3 = Color3.fromRGB(68, 88, 165)
    b.TextColor3 = Color3.new(1, 1, 1)
    b.Font = Enum.Font.GothamBold
    b.TextSize = 14
    b.Text = text
    b.Parent = parent
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 7)
    return b
end

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, -50, 0, 34)
title.Position = UDim2.fromOffset(10, 0)
title.BackgroundTransparency = 1
title.Text = "🛴 Air Spin"
title.TextColor3 = Color3.new(1, 1, 1)
title.Font = Enum.Font.GothamBold
title.TextSize = 18
title.Parent = panel

local hideButton = Instance.new("TextButton")
hideButton.Size = UDim2.fromOffset(32, 28)
hideButton.Position = UDim2.new(1, -38, 0, 3)
hideButton.Text = "—"
hideButton.Parent = panel

local spinButton = makeButton("Air Spin", 40, panel)
local fallButton = makeButton("Air Spin (Fall)", 80, panel)
local musicButton = makeButton("▶ Play Music", 120, panel)
local songButton = makeButton("♫ Song: 1 tap", 160, panel)

local function makeSlider(label, y, minValue, maxValue, initial, callback)
    local value = initial

    local text = Instance.new("TextLabel")
    text.Size = UDim2.new(1, -20, 0, 20)
    text.Position = UDim2.fromOffset(10, y)
    text.BackgroundTransparency = 1
    text.TextColor3 = Color3.new(1, 1, 1)
    text.Font = Enum.Font.Gotham
    text.TextSize = 13
    text.TextXAlignment = Enum.TextXAlignment.Left
    text.Parent = panel

    local bar = Instance.new("TextButton")
    bar.Size = UDim2.new(1, -20, 0, 10)
    bar.Position = UDim2.fromOffset(10, y + 23)
    bar.Text = ""
    bar.BackgroundColor3 = Color3.fromRGB(65, 65, 78)
    bar.Parent = panel
    Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame")
    fill.BackgroundColor3 = Color3.fromRGB(115, 155, 255)
    fill.BorderSizePixel = 0
    fill.Parent = bar
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local function update(x)
        local ratio = math.clamp(
            (x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1
        )
        value = math.floor(minValue + ratio * (maxValue - minValue))
        fill.Size = UDim2.fromScale(ratio, 1)
        text.Text = label .. ": " .. value
        callback(value)
    end

    update(bar.AbsolutePosition.X +
        bar.AbsoluteSize.X * ((initial - minValue) / (maxValue - minValue)))

    bar.Activated:Connect(function()
        -- Mouse/touch click position is not exposed by Activated.
        -- Drag the slider to adjust it.
    end)

    local dragging = false
    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            update(input.Position.X)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            update(input.Position.X)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

makeSlider("Spin speed (deg/sec)", 205, 180, 3600, spinSpeed,
    function(v) spinSpeed = v end)
makeSlider("Launch power", 260, 20, 150, jumpPower,
    function(v) jumpPower = v end)
makeSlider("Number of spins", 315, 1, 30, spinCount,
    function(v) spinCount = v end)

local function doTrick(launch)
    if busy then return end

    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not humanoid or not root or humanoid.Health <= 0 then return end

    busy = true

    if launch then
        root.AssemblyLinearVelocity = Vector3.new(
            root.AssemblyLinearVelocity.X,
            jumpPower,
            root.AssemblyLinearVelocity.Z
        )
    else
        humanoid.Jump = true
    end

    local duration = (360 * spinCount) / spinSpeed
    local elapsed = 0
    local connection

    connection = RunService.RenderStepped:Connect(function(dt)
        if not root.Parent or humanoid.Health <= 0 then
            connection:Disconnect()
            busy = false
            return
        end

        elapsed += dt
        local angle = math.rad(spinSpeed * elapsed)
        root.CFrame = CFrame.new(root.Position)
            * CFrame.Angles(0, angle, 0)

        if elapsed >= duration then
            connection:Disconnect()
            busy = false
        end
    end)
end

spinButton.Activated:Connect(function()
    doTrick(false)
end)

fallButton.Activated:Connect(function()
    doTrick(true)
end)

musicButton.Activated:Connect(function()
    if music.IsPlaying then
        music:Stop()
        musicButton.Text = "▶ Play Music"
    else
        music:Play()
        musicButton.Text = "■ Stop Music"
    end
end)

songButton.Activated:Connect(function()
    songIndex = songIndex % #songNames + 1
    local name = songNames[songIndex]
    music.SoundId = "rbxassetid://" .. songs[name]
    songButton.Text = "♫ Song: " .. name
    if music.IsPlaying then music:Play() end
end)

-- Drag the panel by its title.
local dragging, dragStart, startPosition = false, nil, nil
title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPosition = panel.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    ) then
        local delta = input.Position - dragStart
        panel.Position = UDim2.new(
            startPosition.X.Scale, startPosition.X.Offset + delta.X,
            startPosition.Y.Scale, startPosition.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

local showButton = Instance.new("TextButton")
showButton.Size = UDim2.fromOffset(100, 36)
showButton.Position = UDim2.fromOffset(20, 100)
showButton.Text = "🛴 Show GUI"
showButton.Visible = false
showButton.Parent = gui

hideButton.Activated:Connect(function()
    panel.Visible = false
    showButton.Visible = true
end)

showButton.Activated:Connect(function()
    panel.Visible = true
    showButton.Visible = false
end)
