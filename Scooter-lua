local function makeSlider(label, y, minValue, maxValue, initial, callback)
    local value = initial

    local text = Instance.new("TextLabel")
    text.Size = UDim2.new(1, -24, 0, 20)
    text.Position = UDim2.fromOffset(12, y)
    text.BackgroundTransparency = 1
    text.TextColor3 = Color3.fromRGB(241, 231, 255)
    text.Font = Enum.Font.Gotham
    text.TextSize = 12
    text.TextXAlignment = Enum.TextXAlignment.Left
    text.Parent = panel

    local bar = Instance.new("TextButton")
    bar.Size = UDim2.new(1, -24, 0, 10)
    bar.Position = UDim2.fromOffset(12, y + 22)
    bar.Text = ""
    bar.BorderSizePixel = 0
    bar.BackgroundColor3 = Color3.fromRGB(62, 51, 78)
    bar.Parent = panel
    Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.fromScale((initial - minValue) / (maxValue - minValue), 1)
    fill.BackgroundColor3 = Color3.fromRGB(194, 123, 255)
    fill.BorderSizePixel = 0
    fill.Parent = bar
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    text.Text = label .. ": " .. value
    callback(value)

    local function update(x)
        local width = bar.AbsoluteSize.X
        if width <= 0 then return end

        local ratio = math.clamp(
            (x - bar.AbsolutePosition.X) / width, 0, 1
        )
        value = math.floor(minValue + ratio * (maxValue - minValue))
        fill.Size = UDim2.fromScale(ratio, 1)
        text.Text = label .. ": " .. value
        callback(value)
    end

    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            update(input.Position.X)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            if UserInputService:IsMouseButtonPressed(
                Enum.UserInputType.MouseButton1
            ) then
                update(input.Position.X)
            end
        end
    end)
end

