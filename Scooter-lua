    local icon = Instance.new("TextLabel")
    icon.Size = UDim2.fromOffset(30, height)
    icon.Position = UDim2.fromOffset(8, 0)
    icon.BackgroundTransparency = 1
    icon.Text = iconText or "✦"
    icon.TextColor3 = LIGHT_PURPLE
    icon.Font = Enum.Font.GothamBold
    icon.TextSize = 17
    icon.Parent = button

    local label = Instance.new("TextLabel")
    label.Name = "ButtonLabel"
    label.Size = UDim2.new(1, -54, 1, 0)
    label.Position = UDim2.fromOffset(39, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = WHITE
    label.Font = Enum.Font.GothamBold
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = button

    button.MouseEnter:Connect(function()
        if not button:GetAttribute("Active") then
            TweenService:Create(button, TweenInfo.new(0.15), {
                BackgroundColor3 = Color3.fromRGB(88, 55, 123)
            }):Play()
        end
    end)

    button.MouseLeave:Connect(function()
        if not button:GetAttribute("Active") then
            TweenService:Create(button, TweenInfo.new(0.15), {
                BackgroundColor3 = BUTTON
            }):Play()
        end
    end)

    return button, label, stroke
end

