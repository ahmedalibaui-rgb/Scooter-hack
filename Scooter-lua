local function stopTrick(message)
    trickToken += 1
    activeTrick = nil
    airButton.Text = "Air Spin: OFF"
    fallButton.Text = "Air Spin (Fall): OFF"
    if message then notify(message) end
end

-- Trick sequence: spins through the requested rotations,
-- then allows normal gravity to bring the character down.
local function startTrick(launch)
    if activeTrick then
        stopTrick("Trick cancelled")
        return
    end

    local _, humanoid, root = getParts()
    if not humanoid or not root then
        notify("Character not ready")
        return
    end

    trickToken += 1
    local myToken = trickToken
    activeTrick = launch and "fall" or "air"
    airButton.Text = launch and "Air Spin: OFF" or "Air Spin: ON"
    fallButton.Text = launch and "Air Spin (Fall): ON" or "Air Spin (Fall): OFF"

    if launch then
        root.AssemblyLinearVelocity = Vector3.new(
            root.AssemblyLinearVelocity.X,
            jumpPower,
            root.AssemblyLinearVelocity.Z
        )
    else
        humanoid.Jump = true
    end

    notify(launch and "Catapult spin started" or "Air spin started")

    task.spawn(function()
        local duration = (360 * spinCount) / math.max(spinSpeed, 1)
        local elapsed = 0
        local startCFrame = root.CFrame
        local startPosition = root.Position

        while elapsed < duration and trickToken == myToken do
            local dt = RunService.Heartbeat:Wait()
            if not root.Parent or humanoid.Health <= 0 then break end

            elapsed = math.min(elapsed + dt, duration)
            local angle = math.rad(360 * spinCount) * (elapsed / duration)

            -- Preserve the current position while applying the original
            -- trick's Y-axis rotation.
            root.CFrame = CFrame.new(root.Position)
                * (startCFrame - startPosition)
                * CFrame.Angles(0, angle, 0)
        end

        if trickToken ~= myToken then return end

        activeTrick = nil
        airButton.Text = "Air Spin: OFF"
        fallButton.Text = "Air Spin (Fall): OFF"
        notify("Trick finished")
    end)
end

airButton.Activated:Connect(function()
