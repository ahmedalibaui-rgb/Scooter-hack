-- Airborne-only spinning.
RunService.RenderStepped:Connect(function(dt)
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not humanoid or not root then return end

    local airborne = humanoid.FloorMaterial == Enum.Material.Air
    if airspinEnabled and airborne then
        spinAngle += math.rad(spinSpeed) * dt
        root.CFrame = CFrame.new(root.Position)
            * CFrame.Angles(0, spinAngle, 0)
            * (root.CFrame - root.Position)
    end
end)

airButton.Activated:Connect(function()
    airspinEnabled = not airspinEnabled
    airButton.Text = airspinEnabled and "Airspin: ON" or "Airspin: OFF"
    notify(airButton.Text)
end)

catButton.Activated:Connect(function()
    catapultEnabled = not catapultEnabled
    catButton.Text = catapultEnabled and "Catapult: ON" or "Catapult: OFF"
    notify(catButton.Text)

    if catapultEnabled then
        local character = player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if humanoid and root then
            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            root.AssemblyLinearVelocity = Vector3.new(
                root.AssemblyLinearVelocity.X,
                launchPower,
                root.AssemblyLinearVelocity.Z
            )
        end
    end
end)

songButton.Activated:Connect(function()
    songIndex = songIndex % #songNames + 1
    local name = songNames[songIndex]
    sound.SoundId = "rbxassetid://" .. songs[name]
    songButton.Text = "♫ " .. name
    if sound.IsPlaying then sound:Play() end
    notify("Song: " .. name)
end)

musicButton.Activated:Connect(function()
    if sound.IsPlaying then
        sound:Stop()
        musicButton.Text = "▶ Play music"
    else
        sound:Play()
        musicButton.Text = "■ Stop music"
    end
end)

