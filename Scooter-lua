-- Character helpers
local function getParts()
    local character = player.Character
    if not character then return end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not root or humanoid.Health <= 0 then
        return
    end

    return character, humanoid, root
end

local function updateButtonStates()
    local states = {
        air = {airButton, airLabel, "Air Spin"},
        fall = {fallButton, fallLabel, "Air Spin (Fall)"},
        loop = {loopButton, loopLabel, "Air Loop"}
    }

    for mode, item in pairs(states) do
        local button, label, name = item
        local on = activeTrick == mode

        label.Text = name .. (on and "  •  ON" or "  •  OFF")
        button.BackgroundColor3 = on and ACTIVE or BUTTON
        button:SetAttribute("Active", on)
    end

    statusDot.BackgroundColor3 = activeTrick
        and Color3.fromRGB(255, 198, 91)
        or Color3.fromRGB(104, 230, 156)

    statusText.Text = activeTrick
        and "TRICK ACTIVE  •  Press again to stop"
        or "READY  •  Choose a trick"
end

local function stopTrick(message)
    trickToken += 1
    activeTrick = nil

    local _, humanoid = getParts()
    if humanoid then
        humanoid.AutoRotate = true
    end

    updateButtonStates()
    if message then notify(message) end
end

-- All tricks loop until manually stopped.
-- Air Spin rotates around the vertical axis.
-- Air Loop rotates around the character's local X axis.
local function startTrick(mode)
    if activeTrick == mode then
        stopTrick("Trick stopped")
        return
    end

    if activeTrick then
        stopTrick()
    end

    local _, humanoid, root = getParts()
    if not humanoid or not root then
        notify("Character not ready")
        return
    end

    trickToken += 1
    local myToken = trickToken
    activeTrick = mode
    humanoid.AutoRotate = false
    updateButtonStates()
    notify(mode == "loop" and "Air Loop activated" or "Trick loop activated")

    task.spawn(function()
        while activeTrick == mode and trickToken == myToken do
            local _, currentHumanoid, currentRoot = getParts()
            if not currentHumanoid or not currentRoot then break end

            -- Launch from the ground at the beginning of each cycle.
            if currentHumanoid.FloorMaterial ~= Enum.Material.Air then
                if mode == "fall" then
                    currentRoot.AssemblyLinearVelocity = Vector3.new(
                        currentRoot.AssemblyLinearVelocity.X,
                        jumpPower,
                        currentRoot.AssemblyLinearVelocity.Z
                    )
                else
                    currentHumanoid.Jump = true
                    currentHumanoid:ChangeState(
                        Enum.HumanoidStateType.Jumping
                    )
                end
            end

            local duration = (360 * spinCount) / math.max(spinSpeed, 1)
            local elapsed = 0
            local startCFrame = currentRoot.CFrame
            local startPosition = currentRoot.Position

            while elapsed < duration
                and activeTrick == mode
                and trickToken == myToken do

                local dt = RunService.Heartbeat:Wait()
                if not currentRoot.Parent or currentHumanoid.Health <= 0 then
                    break
                end

                elapsed = math.min(elapsed + dt, duration)
                local angle = math.rad(360 * spinCount)
                    * (elapsed / duration)

                local rotation
                if mode == "loop" then
                    rotation = CFrame.Angles(angle, 0, 0)
                else
                    rotation = CFrame.Angles(0, angle, 0)
                end

                currentRoot.CFrame = CFrame.new(currentRoot.Position)
                    * (startCFrame - startPosition)
                    * rotation
            end

            if activeTrick ~= mode or trickToken ~= myToken then
                break
            end

            -- Wait until the character lands before relaunching.
            while currentHumanoid.Parent
                and currentHumanoid.Health > 0
                and currentHumanoid.FloorMaterial == Enum.Material.Air
                and activeTrick == mode
                and trickToken == myToken do
                RunService.Heartbeat:Wait()
            end

            if activeTrick == mode and trickToken == myToken then
                task.wait(0.1)
            end
        end

        if trickToken == myToken then
            activeTrick = nil
            local _, currentHumanoid = getParts()
            if currentHumanoid then
                currentHumanoid.AutoRotate = true
            end
            updateButtonStates()
            notify("Trick stopped")
        end
    end)
end

