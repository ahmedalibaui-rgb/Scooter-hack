-- DRAG PANEL BY TITLE
local draggingPanel = false
local dragStart
local startPosition

title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        draggingPanel = true
        dragStart = input.Position
        startPosition = panel.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if draggingPanel and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    ) then
        local delta = input.Position - dragStart
        panel.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        draggingPanel = false
    end
end)

-- TRICK LOGIC
local function stopTrick()
    trickToken += 1
    activeTrick = nil

    spinButton.Text = "Air Spin"
    fallButton.Text = "Air Spin (Fall)"
    status.Text = "Ready"
end

local function doTrick(trickName)
    -- Clicking the active trick toggles it off.
    if activeTrick == trickName then
        stopTrick()
        return
    end

    -- Switching tricks cancels the previous trick.
    trickToken += 1
    local myToken = trickToken
    activeTrick = trickName

    spinButton.Text = trickName == "float" and "Air Spin [ON]" or "Air Spin"
    fallButton.Text = trickName == "fall" and "Air Spin (Fall) [ON]" or "Air Spin (Fall)"
    status.Text = trickName == "float" and "Air Spin active" or "Fall spin active"

    task.spawn(function()
        local character = player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local root = character and character:FindFirstChild("HumanoidRootPart")

        if not humanoid or not root or humanoid.Health <= 0 then
            if trickToken == myToken then
                stopTrick()
            end
            return
        end

        if trickName == "fall" then
            -- Keeps the original launch behavior.
            root.AssemblyLinearVelocity = Vector3.new(
                root.AssemblyLinearVelocity.X,
                jumpPower,
                root.AssemblyLinearVelocity.Z
            )

            local duration = (360 * spinCount) / math.max(spinSpeed, 1)
            local elapsed = 0

            while elapsed < duration
                and activeTrick == trickName
                and trickToken == myToken
                and root.Parent
                and humanoid.Health > 0 do

                elapsed += RunService.RenderStepped:Wait()
                local angle = math.rad(spinSpeed * elapsed)
                root.CFrame = CFrame.new(root.Position)
                    * CFrame.Angles(0, angle, 0)
            end

        elseif trickName == "float" then
            -- Smooth float up; no jump impulse.
            local startCFrame = root.CFrame
            local startPosition = root.Position
            local originalRotation = startCFrame - startPosition
            local targetPosition = startPosition + Vector3.new(0, floatHeight, 0)
            local previousAutoRotate = humanoid.AutoRotate

            humanoid.AutoRotate = false

            local riseDuration = 0.35
            local elapsed = 0

            while elapsed < riseDuration
                and activeTrick == trickName
                and trickToken == myToken
                and root.Parent
                and humanoid.Health > 0 do

                elapsed += RunService.RenderStepped:Wait()
                local alpha = math.clamp(elapsed / riseDuration, 0, 1)
                local position = startPosition:Lerp(targetPosition, alpha)
                root.CFrame = CFrame.new(position) * originalRotation
            end

            -- Spin while smoothly returning to the starting height.
            local duration = (360 * spinCount) / math.max(spinSpeed, 1)
            elapsed = 0

            while elapsed < duration
                and activeTrick == trickName
                and trickToken == myToken
                and root.Parent
                and humanoid.Health > 0 do

                elapsed += RunService.RenderStepped:Wait()
                local alpha = math.clamp(elapsed / duration, 0, 1)
                local position = targetPosition:Lerp(startPosition, alpha)
                local angle = math.rad(spinSpeed * elapsed)

                root.CFrame = CFrame.new(position)
                    * originalRotation
                    * CFrame.Angles(0, angle, 0)
            end

            -- Pause on the ground for the selected duration.
            if activeTrick == trickName
                and trickToken == myToken
                and root.Parent
                and humanoid.Health > 0 then
                task.wait(groundTime)
            end

            if humanoid.Parent then
                humanoid.AutoRotate = previousAutoRotate
            end
        end

        if trickToken == myToken then
            stopTrick()
        end
    end)
end

