local function makeLabel(parent, text, size, pos, fontSize, color)
    local obj = Instance.new("TextLabel")
    obj.BackgroundTransparency = 1
    obj.Size = size
    obj.Position = pos
    obj.Font = Enum.Font.GothamBold
    obj.Text = text
    obj.TextSize = fontSize
    obj.TextColor3 = color or WHITE
    obj.TextXAlignment = Enum.TextXAlignment.Left
    obj.Parent = parent
    return obj
end

local function makeButton(parent, text, pos, size, accent)
    local obj = Instance.new("TextButton")
    obj.Size = size
    obj.Position = pos
    obj.BackgroundColor3 = accent and PURPLE or PANEL
    obj.BorderSizePixel = 0
    obj.Text = text
    obj.TextColor3 = WHITE
    obj.Font = Enum.Font.GothamBold
    obj.TextSize = 13
    obj.AutoButtonColor = true
    obj.Active = true
    obj.Selectable = true
    obj.Parent = parent
    corner(obj, 10)

    local stroke = Instance.new("UIStroke", obj)
    stroke.Color = accent and PINK or PURPLE
    stroke.Transparency = accent and 0.15 or 0.55
    stroke.Thickness = 1

    return obj
end

