--// Character
local function getParts()
    local character = player.Character
    if not character then return end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not root or humanoid.Health <= 0 then
        return
    end

    return character, humanoid, root
end

local function updateButtonStates()
    local airOn = activeTrick == "air"
    local fallOn = activeTrick == "fall"

    airLabel.Text = airOn and "Air Spin  •  ON" or "Air Spin  •  OFF"
    fallLabel.Text = fallOn and "Air Spin (Fall)  •  ON"
        or "Air Spin (Fall)  •  OFF"

    airButton.BackgroundColor3 = airOn
        and Color3.fromRGB(104, 62, 151) or BUTTON
    fallButton.BackgroundColor3 = fallOn
        and Color3.fromRGB(104, 62, 151) or BUTTON

    statusDot.BackgroundColor3 = activeTrick
        and Color3.fromRGB(255, 198, 91)
        or Color3.fromRGB(104, 230, 156)

    statusText.Text = activeTrick
        and "TRICK ACTIVE  •  Press again to stop"
        or "READY  •  Choose a trick"
end

local function stopTrick(message)
    trickToken += 1
    activeTrick = nil
    updateButtonStates()

    local _, humanoid = getParts()
    if humanoid then
        humanoid.AutoRotate = true
    end

    if message then notify(message) end
end

-- One sequence per click; no automatic relaunch loop.
local function startTrick(launch)
    local mode = launch and "fall" or "air"

    if activeTrick == mode then
        stopTrick("Trick cancelled")
        return
    elseif activeTrick then
        stopTrick()
    end

    local _, humanoid, root = getParts()
    if not humanoid or not root then
        notify("Character not ready")
        return
    end

    trickToken += 1
    local myToken = trickToken
    activeTrick = mode
    updateButtonStates()

    humanoid.AutoRotate = false

    if launch then
        root.AssemblyLinearVelocity = Vector3.new(
            root.AssemblyLinearVelocity.X,
            jumpPower,
            root.AssemblyLinearVelocity.Z
        )
    else
        humanoid.Jump = true
        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end

    notify(launch and "Air Spin (Fall) started" or "Air Spin started")

    task.spawn(function()
        local duration = (360 * spinCount) / math.max(spinSpeed, 1)
        local elapsed = 0
        local startCFrame = root.CFrame
        local startPosition = root.Position

        while elapsed < duration and trickToken == myToken do
            local dt = RunService.Heartbeat:Wait()

            if not root.Parent or humanoid.Health <= 0 then
                break
            end

            elapsed = math.min(elapsed + dt, duration)
            local angle = math.rad(spinSpeed * elapsed)

            root.CFrame = CFrame.new(root.Position)
                * (startCFrame - startPosition)
                * CFrame.Angles(0, angle, 0)
        end

        if trickToken ~= myToken then return end

        activeTrick = nil
        humanoid.AutoRotate = true
        updateButtonStates()
        notify("Trick finished")
    end)
end

