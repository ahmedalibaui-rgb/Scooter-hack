-- SLIDERS
local function makeSlider(label, y, minValue, maxValue, initial, callback, decimals)
    local value = initial

    local text = Instance.new("TextLabel")
    text.Size = UDim2.new(1, -20, 0, 20)
    text.Position = UDim2.fromOffset(10, y)
    text.BackgroundTransparency = 1
    text.TextColor3 = Color3.new(1, 1, 1)
    text.Font = Enum.Font.Gotham
    text.TextSize = 13
    text.TextXAlignment = Enum.TextXAlignment.Left
    text.Parent = panel

    local bar = Instance.new("TextButton")
    bar.Size = UDim2.new(1, -20, 0, 10)
    bar.Position = UDim2.fromOffset(10, y + 23)
    bar.Text = ""
    bar.BackgroundColor3 = Color3.fromRGB(65, 65, 78)
    bar.Parent = panel
    Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame")
    fill.BackgroundColor3 = Color3.fromRGB(115, 155, 255)
    fill.BorderSizePixel = 0
    fill.Parent = bar
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local dragging = false

    local function formatValue(v)
        if decimals then
            return string.format("%." .. decimals .. "f", v)
        end
        return tostring(math.floor(v + 0.5))
    end

    local function update(x)
        local width = math.max(bar.AbsoluteSize.X, 1)
        local ratio = math.clamp(
            (x - bar.AbsolutePosition.X) / width, 0, 1
        )

        if decimals then
            local scale = 10 ^ decimals
            value = math.floor(
                (minValue + ratio * (maxValue - minValue)) * scale + 0.5
            ) / scale
        else
            value = math.floor(
                minValue + ratio * (maxValue - minValue) + 0.5
            )
        end

        fill.Size = UDim2.fromScale(ratio, 1)
        text.Text = label .. ": " .. formatValue(value)
        callback(value)
    end

    local initialRatio = (initial - minValue) / (maxValue - minValue)
    fill.Size = UDim2.fromScale(initialRatio, 1)
    text.Text = label .. ": " .. formatValue(initial)
    callback(initial)

    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            update(input.Position.X)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            update(input.Position.X)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

