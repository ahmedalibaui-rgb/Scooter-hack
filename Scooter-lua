-- TRICK SYSTEM
local function stopTrick()
    trickToken += 1
    activeTrick = nil
    spinButton.Text = "Air Spin  |  OFF"
    fallButton.Text = "Air Spin (Fall)  |  OFF"
    status.Text = "Ready"
end

local function doTrick(trickName)
    if activeTrick == trickName then
        stopTrick()
        return
    end

    -- Stop the previous trick and invalidate its animation loop.
    trickToken += 1
    local myToken = trickToken
    activeTrick = trickName

    spinButton.Text = trickName == "float" and "Air Spin  |  ON" or "Air Spin  |  OFF"
    fallButton.Text = trickName == "fall" and "Air Spin (Fall)  |  ON" or "Air Spin (Fall)  |  OFF"
    status.Text = trickName == "float" and "Floating spin active" or "Fall spin active"

    task.spawn(function()
        local character = player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local root = character and character:FindFirstChild("HumanoidRootPart")

        if not humanoid or not root or humanoid.Health <= 0 then
            stopTrick()
            return
        end

        if trickName == "fall" then
            -- Preserves the original launch behavior.
            root.AssemblyLinearVelocity = Vector3.new(
                root.AssemblyLinearVelocity.X,
                jumpPower,
                root.AssemblyLinearVelocity.Z
            )

            local duration = (360 * spinCount) / math.max(spinSpeed, 1)
            local elapsed = 0

            while elapsed < duration and activeTrick == trickName
                and trickToken == myToken and root.Parent and humanoid.Health > 0 do
                local dt = RunService.RenderStepped:Wait()
                elapsed += dt
                local angle = math.rad(spinSpeed * elapsed)
                root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, angle, 0)
            end

        elseif trickName == "float" then
            -- Smoothly raise the character without triggering a jump.
            local startCFrame = root.CFrame
            local startPosition = root.Position
            local originalRotation = startCFrame - startPosition
            local targetPosition = startPosition + Vector3.new(0, floatHeight, 0)
            local humanoidAutoRotate = humanoid.AutoRotate
            humanoid.AutoRotate = false

            local riseDuration = 0.35
            local riseElapsed = 0

            while riseElapsed < riseDuration and activeTrick == trickName
                and trickToken == myToken and root.Parent and humanoid.Health > 0 do
                local dt = RunService.RenderStepped:Wait()
                riseElapsed += dt
                local alpha = math.clamp(riseElapsed / riseDuration, 0, 1)
                local position = startPosition:Lerp(targetPosition, alpha)
                root.CFrame = CFrame.new(position) * originalRotation
            end

            local spinDuration = (360 * spinCount) / math.max(spinSpeed, 1)
            local spinElapsed = 0

            while spinElapsed < spinDuration and activeTrick == trickName
                and trickToken == myToken and root.Parent and humanoid.Health > 0 do
                local dt = RunService.RenderStepped:Wait()
                spinElapsed += dt
                local alpha = math.clamp(spinElapsed / spinDuration, 0, 1)
                local angle = math.rad(spinSpeed * spinElapsed)
                local position = targetPosition:Lerp(startPosition, alpha)
                root.CFrame = CFrame.new(position) * originalRotation
                    * CFrame.Angles(0, angle, 0)
            end

            -- Hold at the starting/ground position for the selected duration.
            if activeTrick == trickName and trickToken == myToken
                and root.Parent and humanoid.Health > 0 then
                task.wait(groundTime)
            end

            humanoid.AutoRotate = humanoidAutoRotate
        end

        if trickToken == myToken then
            stopTrick()
        end
    end)
end

