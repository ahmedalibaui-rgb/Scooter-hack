local function getCharacterParts()
    local character = player.Character
    if not character then return end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not root then return end
    return character, humanoid, root
end

-- Sliders
local function makeSlider(label, y, minV, maxV, initial, callback)
    local txt = Instance.new("TextLabel")
    txt.Size = UDim2.new(1, -24, 0, 20)
    txt.Position = UDim2.fromOffset(12, y)
    txt.BackgroundTransparency = 1
    txt.TextColor3 = Color3.fromRGB(240, 230, 255)
    txt.Font = Enum.Font.Gotham
    txt.TextSize = 12
    txt.TextXAlignment = Enum.TextXAlignment.Left
    txt.Parent = panel

    local bar = Instance.new("TextButton")
    bar.Size = UDim2.new(1, -24, 0, 10)
    bar.Position = UDim2.fromOffset(12, y + 22)
    bar.Text = ""
    bar.BorderSizePixel = 0
    bar.BackgroundColor3 = Color3.fromRGB(65, 55, 80)
    bar.Parent = panel
    Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.fromScale((initial - minV) / (maxV - minV), 1)
    fill.BackgroundColor3 = Color3.fromRGB(195, 125, 255)
    fill.BorderSizePixel = 0
    fill.Parent = bar
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local value = initial
    txt.Text = label .. ": " .. value
    callback(value)

    local function update(x)
        local width = bar.AbsoluteSize.X
        if width <= 0 then return end

        local ratio = math.clamp(
            (x - bar.AbsolutePosition.X) / width, 0, 1
        )
        value = math.floor(minV + ratio * (maxV - minV))
        fill.Size = UDim2.fromScale(ratio, 1)
        txt.Text = label .. ": " .. value
        callback(value)
    end

    bar.Activated:Connect(function()
        -- Touch-friendly click behavior; dragging is handled below.
    end)

    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            update(input.Position.X)
        end
    end)

    local moveConnection = UIS.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            if UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
                update(input.Position.X)
            end
        end
    end)
    table.insert(dragConnections, moveConnection)
end

