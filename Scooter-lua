local function updateTrickButtons()
    if activeTrick == "spin" then
        spinButton.Text = "■   AIR SPIN  •  ON"
        spinButton.BackgroundColor3 = PURPLE
    else
        spinButton.Text = "▶   AIR SPIN"
        spinButton.BackgroundColor3 = PANEL
    end

    if activeTrick == "fall" then
        fallButton.Text = "■   AIR SPIN (FALL)  •  ON"
        fallButton.BackgroundColor3 = PURPLE
    else
        fallButton.Text = "▶   AIR SPIN (FALL)"
        fallButton.BackgroundColor3 = PANEL
    end

    if activeTrick then
        status.Text = "●  " .. string.upper(activeTrick) .. " ACTIVE"
        status.TextColor3 = GREEN
    else
        status.Text = "●  ALL TRICKS OFF"
        status.TextColor3 = MUTED
    end
end

local function stopTrick()
    trickToken += 1
    activeTrick = nil
    updateTrickButtons()
end

local function startTrick(mode)
    if activeTrick == mode then
        stopTrick()
        return
    end

    trickToken += 1
    local myToken = trickToken
    activeTrick = mode
    updateTrickButtons()

    task.spawn(function()
        while activeTrick == mode and trickToken == myToken do
            local character = player.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local root = character and character:FindFirstChild("HumanoidRootPart")

            if not humanoid or not root or humanoid.Health <= 0 then
                task.wait(0.2)
                continue
            end

            -- Preserve the original working movement behavior.
            if mode == "fall" then
                root.AssemblyLinearVelocity = Vector3.new(
                    root.AssemblyLinearVelocity.X,
                    launchPower,
                    root.AssemblyLinearVelocity.Z
                )
            else
                humanoid.Jump = true
            end

            local duration = (360 * spinCount) / math.max(spinSpeed, 1)
            local elapsed = 0

            while elapsed < duration
                and activeTrick == mode
                and trickToken == myToken
                and root.Parent
                and humanoid.Health > 0 do

                local dt = RunService.RenderStepped:Wait()
                elapsed += dt

                local angle = math.rad(spinSpeed * elapsed)
                root.CFrame = CFrame.new(root.Position)
                    * CFrame.Angles(0, angle, 0)
            end

            if activeTrick ~= mode or trickToken ~= myToken then
                break
            end

            -- Keep the toggle active: repeat until clicked again.
            task.wait(0.1)
        end
    end)
end

