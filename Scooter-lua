local function playMusic(trackName)
    if musicSound then
        musicSound:Stop()
        musicSound:Destroy()
        musicSound = nil
    end

    musicSound = Instance.new("Sound")
    musicSound.Name = "RZR_Music"
    musicSound.SoundId = MUSIC[trackName]
    musicSound.Volume = 0.5
    musicSound.Looped = true
    musicSound.Parent = gui
    musicSound:Play()
end

