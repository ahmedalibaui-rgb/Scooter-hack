
--[[
    SCOOTER TRICK CONTROLLER
    Roblox Studio prototype
    Place this LocalScript in StarterPlayerScripts.

    Controls:
    - Height
    - Spin speed
    - Number of rotations
    - Start / Stop
    - Music and volume

    Note: This animates the character root only.
    A separate vehicle assembly must be controlled by
    its own vehicle system to stay attached correctly.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local HEIGHT = 5
local SPIN_SPEED = 1080
local SPINS = 15
local RISE_TIME = 0.6
local FALL_TIME = 0.6

local MUSIC_ID = "rbxassetid://125476440612900"

local running = false
local animationConnection
local cycleToken = 0

-- GUI
local gui = Instance.new("ScreenGui")
gui.Name = "ScooterTrickController"
gui.ResetOnSpawn = false
gui.Parent = playerGui

local panel = Instance.new("Frame")
panel.Size = UDim2.fromOffset(280, 370)
panel.Position = UDim2.new(0, 20, 0.3, 0)
panel.BackgroundColor3 = Color3.fromRGB(25, 25, 32)
panel.BorderSizePixel = 0
panel.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 12)
corner.Parent = panel

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, -20, 0, 38)
title.Position = UDim2.fromOffset(10, 5)
title.BackgroundTransparency = 1
title.Text = "🛴 SCOOTER TRICKS"
title.TextColor3 = Color3.new(1, 1, 1)
title.Font = Enum.Font.GothamBold
title.TextSize = 17
title.Parent = panel

local function makeInput(labelText, default, y)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromOffset(130, 28)
    label.Position = UDim2.fromOffset(12, y)
    label.BackgroundTransparency = 1
    label.Text = labelText
    label.TextColor3 = Color3.new(1, 1, 1)
    label.Font = Enum.Font.Gotham
    label.TextSize = 12
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = panel

    local input = Instance.new("TextBox")
    input.Size = UDim2.fromOffset(105, 28)
    input.Position = UDim2.fromOffset(160, y)
    input.BackgroundColor3 = Color3.fromRGB(48, 48, 60)
    input.TextColor3 = Color3.new(1, 1, 1)
    input.PlaceholderText = tostring(default)
    input.Text = tostring(default)
    input.Font = Enum.Font.Gotham
    input.TextSize = 13
    input.ClearTextOnFocus = false
    input.Parent = panel

    local inputCorner = Instance.new("UICorner")
    inputCorner.CornerRadius = UDim.new(0, 6)
    inputCorner.Parent = input

    return input
end

local heightInput = makeInput("Height (studs)", HEIGHT, 52)
local speedInput = makeInput("Spin speed (deg/s)", SPIN_SPEED, 91)
local spinsInput = makeInput("Full rotations", SPINS, 130)
local volumeInput = makeInput("Music volume (0-10)", 5, 169)

local function makeButton(text, y, color, callback)
    local button = Instance.new("TextButton")
    button.Size = UDim2.fromOffset(118, 34)
    button.Position = UDim2.fromOffset(12, y)
    button.BackgroundColor3 = color
    button.Text = text
    button.TextColor3 = Color3.new(1, 1, 1)
    button.Font = Enum.Font.GothamBold
    button.TextSize = 13
    button.Parent = panel

    local buttonCorner = Instance.new("UICorner")
    buttonCorner.CornerRadius = UDim.new(0, 7)
    buttonCorner.Parent = button

    button.Activated:Connect(callback)
    return button
end

local status = Instance.new("TextLabel")
status.Size = UDim2.new(1, -24, 0, 25)
status.Position = UDim2.fromOffset(12, 207)
status.BackgroundTransparency = 1
status.Text = "Ready"
status.TextColor3 = Color3.fromRGB(180, 220, 180)
status.Font = Enum.Font.Gotham
status.TextSize = 12
status.Parent = panel

-- Music
local music = Instance.new("Sound")
music.Name = "TrickMusic"
music.SoundId = MUSIC_ID
music.Looped = true
music.Volume = 0.5
music.Parent = gui

local musicButton

local function stopAnimation()
    running = false
    cycleToken += 1

    if animationConnection then
        animationConnection:Disconnect()
        animationConnection = nil
    end

    status.Text = "Stopped"
end

local function startAnimation()
    stopAnimation()

    local character = player.Character
    if not character then
        status.Text = "Character not found"
        return
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not root or humanoid.Health <= 0 then
        status.Text = "Character not ready"
        return
    end

    local height = math.clamp(
        tonumber(heightInput.Text) or 5, 0, 30
    )

    local speed = math.clamp(
        tonumber(speedInput.Text) or 1080, 1, 5000
    )

    local spins = math.clamp(
        math.floor(tonumber(spinsInput.Text) or 15), 1, 100
    )

    local riseTime = RISE_TIME
    local spinTime = (spins * 360) / speed
    local fallTime = FALL_TIME

    local startCFrame = root.CFrame
    local startPosition = startCFrame.Position
    local startRotation = startCFrame - startPosition

    running = true
    cycleToken += 1
    local myToken = cycleToken

    status.Text = "Trick running..."

    local elapsed = 0

    animationConnection = RunService.RenderStepped:Connect(function(dt)
        if not running or myToken ~= cycleToken then
            return
        end

        if not character.Parent or humanoid.Health <= 0 then
            stopAnimation()
            return
        end

        elapsed += dt

        local total = riseTime + spinTime + fallTime
        if elapsed >= total then
            root.CFrame = startCFrame
            elapsed = 0
        end

        local y = 0
        local angle = 0

        if elapsed < riseTime then
            local t = elapsed / riseTime
            local smooth = t * t * (3 - 2 * t)
            y = height * smooth

        elseif elapsed < riseTime + spinTime then
            local t = (elapsed - riseTime) / spinTime
            y = height
            angle = math.rad(spins * 360 * t)

        else
            local t = (elapsed - riseTime - spinTime) / fallTime
            local smooth = t * t * (3 - 2 * t)
            y = height * (1 - smooth)
            angle = math.rad(spins * 360)
        end

        local position = startPosition + Vector3.new(0, y, 0)

        root.CFrame =
            CFrame.new(position)
            * CFrame.Angles(0, angle, 0)
            * startRotation
    end)
end

makeButton(
    "▶ START",
    242,
    Color3.fromRGB(30, 145, 80),
    startAnimation
)

makeButton(
    "■ STOP",
    242,
    Color3.fromRGB(175, 55, 55),
    stopAnimation
)

musicButton = makeButton(
    "♫ PLAY MUSIC",
    285,
    Color3.fromRGB(65, 90, 180),
    function()
        if music.IsPlaying then
            music:Pause()
            musicButton.Text = "♫ PLAY MUSIC"
        else
            local volume = math.clamp(
                tonumber(volumeInput.Text) or 5, 0, 10
            )

            music.Volume = volume / 10
            music:Play()
            musicButton.Text = "♫ PAUSE MUSIC"
        end
    end
)

local closeButton = makeButton(
    "CLOSE GUI",
    327,
    Color3.fromRGB(75, 75, 85),
    function()
        stopAnimation()
        music:Stop()
        gui:Destroy()
    end
)

-- Stop if the character respawns.
player.CharacterAdded:Connect(function()
    stopAnimation()
end)
