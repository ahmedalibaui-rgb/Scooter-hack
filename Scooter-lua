local function makeButton(text, y, height)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -24, 0, height or 35)
    button.Position = UDim2.fromOffset(12, y)
    button.BackgroundColor3 = Color3.fromRGB(65, 85, 160)
    button.TextColor3 = Color3.new(1, 1, 1)
    button.TextSize = 14
    button.Font = Enum.Font.GothamBold
    button.Text = text
    button.Parent = panel
    Instance.new("UICorner", button).CornerRadius = UDim.new(0, 7)
    return button
end

local function makeSlider(label, y, min, max, initial, callback)
    local name = Instance.new("TextLabel")
    name.Size = UDim2.new(1, -24, 0, 20)
    name.Position = UDim2.fromOffset(12, y)
    name.BackgroundTransparency = 1
    name.TextColor3 = Color3.new(1, 1, 1)
    name.TextSize = 13
    name.Font = Enum.Font.Gotham
    name.TextXAlignment = Enum.TextXAlignment.Left
    name.Parent = panel

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(1, -24, 0, 8)
    bar.Position = UDim2.fromOffset(12, y + 25)
    bar.BackgroundColor3 = Color3.fromRGB(65, 65, 75)
    bar.Parent = panel
    Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.fromScale((initial - min) / (max - min), 1)
    fill.BackgroundColor3 = Color3.fromRGB(100, 150, 255)
    fill.Parent = bar
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("TextButton")
    knob.Size = UDim2.fromOffset(18, 18)
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.Position = UDim2.new((initial - min) / (max - min), 0, 0.5, 0)
    knob.Text = ""
    knob.BackgroundColor3 = Color3.new(1, 1, 1)
    knob.Parent = bar
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local dragging = false

    local function update(x)
        local ratio = math.clamp(
            (x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1
        )
        local value = math.floor(min + (max - min) * ratio)
        fill.Size = UDim2.fromScale(ratio, 1)
        knob.Position = UDim2.new(ratio, 0, 0.5, 0)
        name.Text = label .. ": " .. value
        callback(value)
    end

    name.Text = label .. ": " .. initial
    knob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            update(input.Position.X)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            update(input.Position.X)
        end
    end)
end

local function getCharacter()
    local character = player.Character
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")
    if humanoid and root then
        return character, humanoid, root
    end
end

local trickButton = makeButton("▶ Start tricks", 48, 36)
local songButton = makeButton("♫ " .. songs[selectedSong].name, 92, 34)
local musicButton = makeButton("▶ Play music", 132, 34)

local sound = Instance.new("Sound")
sound.Name = "KukirinMusic"
sound.Volume = 0.5
sound.Looped = true
sound.SoundId = "rbxassetid://" .. songs[selectedSong].id
sound.Parent = gui

songButton.Activated:Connect(function()
    selectedSong = selectedSong % #songs + 1
    sound.SoundId = "rbxassetid://" .. songs[selectedSong].id
    songButton.Text = "♫ " .. songs[selectedSong].name
    if isPlaying then
        sound:Play()
    end
end)

musicButton.Activated:Connect(function()
    if isPlaying then
        sound:Stop()
        isPlaying = false
        musicButton.Text = "▶ Play music"
    else
        sound:Play()
        isPlaying = true
        musicButton.Text = "■ Stop music"
    end
end)

makeSlider("Spin speed (degrees/sec)", 176, 180, 3600, spinSpeed,
    function(value) spinSpeed = value end)

makeSlider("Jump height", 230, 1, 20, jumpHeight,
    function(value) jumpHeight = value end)

makeSlider("Number of spins", 284, 1, 30, spinCount,
    function(value) spinCount = value end)

local running = false

trickButton.Activated:Connect(function()
    if running then
        running = false
        trickButton.Text = "▶ Start tricks"
        return
    end

    running = true
    trickButton.Text = "■ Stop tricks"

    task.spawn(function()
        while running do
            local _, humanoid, root = getCharacter()
            if not humanoid or not root then
                task.wait(0.5)
                continue
            end

            humanoid.Jump = true
            task.wait(0.15)

            local totalRotation = math.rad(360 * spinCount)
            local duration = totalRotation / spinSpeed
            local start = os.clock()
            local startCFrame = root.CFrame
            local startY = root.Position.Y

            while running and os.clock() - start < duration do
                local elapsed = os.clock() - start
                local alpha = math.clamp(elapsed / duration, 0, 1)
                local angle = totalRotation * alpha
                local lift = math.sin(alpha * math.pi) * jumpHeight

                root.CFrame =
                    CFrame.new(startCFrame.Position.X,
                        startY + lift,
                        startCFrame.Position.Z)
                    * CFrame.Angles(0, angle, 0)
                    * (startCFrame - startCFrame.Position)

                RunService.Heartbeat:Wait()
            end

            task.wait(0.4)
        end
    end)
end)

-- Make the panel draggable.
local dragging = false
local dragStart
local panelStart

title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        panelStart = panel.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    ) then
        local delta = input.Position - dragStart
        panel.Position = UDim2.new(
            panelStart.X.Scale, panelStart.X.Offset + delta.X,
            panelStart.Y.Scale, panelStart.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

hide.Activated:Connect(function()
    panel.Visible = false

    local show = Instance.new("TextButton")
    show.Size = UDim2.fromOffset(90, 36)
    show.Position = UDim2.fromOffset(20, 100)
    show.Text = "🛴 Show GUI"
    show.Parent = gui

    show.Activated:Connect(function()
        panel.Visible = true
        show:Destroy()
    end)
end)
