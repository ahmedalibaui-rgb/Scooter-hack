local function makeSlider(labelText, y, minValue, maxValue, initialValue, callback)
    local label = makeLabel(
        panel, labelText .. ": " .. tostring(initialValue),
        UDim2.new(1, -34, 0, 20), UDim2.fromOffset(18, y), 12, LIGHT
    )

    local bar = Instance.new("TextButton")
    bar.Name = labelText:gsub("%s+", "") .. "Slider"
    bar.Text = ""
    bar.AutoButtonColor = false
    bar.Active = true
    bar.Size = UDim2.new(1, -36, 0, 12)
    bar.Position = UDim2.fromOffset(18, y + 25)
    bar.BackgroundColor3 = Color3.fromRGB(61, 48, 82)
    bar.BorderSizePixel = 0
    bar.Parent = panel

    local bc = Instance.new("UICorner")
    bc.CornerRadius = UDim.new(1, 0)
    bc.Parent = bar

    local fill = Instance.new("Frame")
    fill.BorderSizePixel = 0
    fill.BackgroundColor3 = PURPLE
    fill.Size = UDim2.new(
        (initialValue - minValue) / (maxValue - minValue), 0, 1, 0
    )
    fill.Parent = bar

    local fc = Instance.new("UICorner")
    fc.CornerRadius = UDim.new(1, 0)
    fc.Parent = fill

    local function setFromX(x)
        local width = math.max(bar.AbsoluteSize.X, 1)
        local ratio = math.clamp(
            (x - bar.AbsolutePosition.X) / width, 0, 1
        )
        local value = math.floor(
            minValue + ratio * (maxValue - minValue) + 0.5
        )

        fill.Size = UDim2.new(ratio, 0, 1, 0)
        label.Text = labelText .. ": " .. tostring(value)
        callback(value)
    end

    bar.Activated:Connect(function()
        setFromX(UserInputService:GetMouseLocation().X)
    end)

    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            draggingSlider = bar
            setFromX(input.Position.X)
        elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
            draggingSlider = bar
            setFromX(input.Position.X)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if draggingSlider == bar and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            setFromX(input.Position.X)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            if draggingSlider == bar then
                draggingSlider = nil
            end
        end
    end)
end

