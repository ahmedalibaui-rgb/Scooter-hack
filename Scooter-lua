-- Trick animation prototype
local function stopTrick()
    running = false
    if connection then
        connection:Disconnect()
        connection = nil
    end
    status.Text = "Stopped"
end

local function startTrick()
    stopTrick()

    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")

    if not root or not humanoid or humanoid.Health <= 0 then
        status.Text = "Character not ready"
        return
    end

    local height = math.clamp(tonumber(heightBox.Text) or 5, 0, 30)
    local speed = math.clamp(tonumber(speedBox.Text) or 1080, 1, 5000)
    local spins = math.clamp(math.floor(tonumber(spinsBox.Text) or 15), 1, 100)

    local startCFrame = root.CFrame
    local origin = startCFrame.Position
    local rotation = startCFrame - origin
    local riseTime, fallTime = 0.6, 0.6
    local spinTime = spins * 360 / speed
    local elapsed = 0

    running = true
    status.Text = "Trick running!"

    connection = RunService.RenderStepped:Connect(function(dt)
        if not running then return end

        if not character.Parent or humanoid.Health <= 0 then
            stopTrick()
            return
        end

        elapsed += dt
        local total = riseTime + spinTime + fallTime

        if elapsed >= total then
            root.CFrame = startCFrame
            elapsed = 0
        end

        local y, angle

        if elapsed < riseTime then
            local t = elapsed / riseTime
            y = height * t * t * (3 - 2 * t)
            angle = 0
        elseif elapsed < riseTime + spinTime then
            local t = (elapsed - riseTime) / spinTime
            y = height
            angle = math.rad(spins * 360 * t)
        else
            local t = (elapsed - riseTime - spinTime) / fallTime
            y = height * (1 - t * t * (3 - 2 * t))
            angle = math.rad(spins * 360)
        end

        root.CFrame = CFrame.new(origin + Vector3.new(0, y, 0))
            * CFrame.Angles(0, angle, 0) * rotation
    end)
end

startButton.Activated:Connect(startTrick)
stopButton.Activated:Connect(stopTrick)

