local function updateButtons()
    local buttonData = {
        {button = airButton, mode = "spin", name = "AIR SPIN"},
        {button = fallButton, mode = "fall", name = "AIR SPIN (FALL)"},
        {button = loopButton, mode = "loop", name = "AIR LOOP"},
    }

    for _, item in ipairs(buttonData) do
        if activeTrick == item.mode then
            item.button.Text = "■  STOP " .. item.name
            item.button.BackgroundColor3 = PURPLE
        else
            item.button.Text = "▶  " .. item.name
            item.button.BackgroundColor3 = PANEL
        end
    end

    if activeTrick then
        statusLabel.Text = "STATUS: " .. string.upper(activeTrick) .. " ON"
        statusLabel.TextColor3 = GREEN
    else
        statusLabel.Text = "STATUS: OFF"
        statusLabel.TextColor3 = MUTED
    end
end

-- CHARACTER HELPERS
local function getCharacterParts()
    local character = player.Character
    if not character then
        return nil, nil, nil
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not root or humanoid.Health <= 0 then
        return nil, nil, nil
    end

    return character, humanoid, root
end

-- STOP CURRENT TRICK
local function stopTrick()
    trickToken += 1
    activeTrick = nil
    updateButtons()
end

-- START / TOGGLE TRICK
local function startTrick(mode)
    -- Pressing the active button turns it off
    if activeTrick == mode then
        stopTrick()
        return
    end

    -- Switching tricks invalidates the previous loop
    trickToken += 1
    local myToken = trickToken
    activeTrick = mode
    updateButtons()

    task.spawn(function()
        while activeTrick == mode and trickToken == myToken do
            local character, humanoid, root = getCharacterParts()

            if not character or not humanoid or not root then
                task.wait(0.25)
                continue
            end

            -- Trigger a jump so the trick can start
            humanoid.Jump = true
            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)

            -- Give the character launch power
            local currentVelocity = root.AssemblyLinearVelocity
            root.AssemblyLinearVelocity = Vector3.new(
                currentVelocity.X,
                launchPower,
                currentVelocity.Z
            )

            -- Wait briefly for the character to leave the ground
            local waitStart = os.clock()
            while humanoid.Health > 0
                and root.Parent
                and humanoid.FloorMaterial ~= Enum.Material.Air
                and os.clock() - waitStart < 1 do

                if trickToken ~= myToken then
                    return
                end

                RunService.Heartbeat:Wait()
            end

            -- Spin for the configured number of rotations
            local angle = 0
            local totalAngle = math.rad(360 * spinCount)
            local maxDuration = math.max(1, (360 * spinCount) / math.max(spinSpeed, 1))
            local elapsed = 0

            while elapsed < maxDuration
                and angle < totalAngle
                and activeTrick == mode
                and trickToken == myToken
                and humanoid.Health > 0
                and root.Parent do

                local dt = RunService.Heartbeat:Wait()
                elapsed += dt

                local step = math.rad(spinSpeed) * dt
                angle = math.min(angle + step, totalAngle)

                local position = root.Position
                local rotation

                if mode == "loop" then
                    -- Front-flip style rotation
                    rotation = CFrame.Angles(angle, 0, 0)
                elseif mode == "fall" then
                    -- Spin while descending
                    rotation = CFrame.Angles(0, angle, 0)
                else
                    -- Standard air spin
                    rotation = CFrame.Angles(0, angle, 0)
                end

                root.CFrame = CFrame.new(position) * rotation
            end

            -- Wait until landing before repeating
            while activeTrick == mode
                and trickToken == myToken
                and humanoid.Health > 0
                and root.Parent
                and humanoid.FloorMaterial == Enum.Material.Air do

                RunService.Heartbeat:Wait()
            end

            if activeTrick == mode and trickToken == myToken then
                task.wait(0.12)
            end
        end
    end)
end

