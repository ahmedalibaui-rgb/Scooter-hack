local function getParts()
    local character = player.Character
    if not character then return nil, nil, nil end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not root or humanoid.Health <= 0 then
        return nil, nil, nil
    end

    return character, humanoid, root
end

local function stopTrick()
    trickToken += 1
    activeTrick = nil
    updateButtons()
end

-- AIR SPIN:
-- No jump command. Smoothly moves up floatHeight studs,
-- spins in place, then returns to the starting position.
--
-- AIR SPIN (FALL):
-- Preserves the original launch-power and spin behavior.

local function startTrick(mode)
    if activeTrick == mode then
        stopTrick()
        return
    end

    trickToken += 1
    local myToken = trickToken
    activeTrick = mode
    updateButtons()

    task.spawn(function()
        while activeTrick == mode and trickToken == myToken do
            local _, humanoid, root = getParts()

            if not humanoid or not root then
                task.wait(0.2)
                continue
            end

            if mode == "fall" then
                -- Original behavior for Air Spin (Fall)
                root.AssemblyLinearVelocity = Vector3.new(
                    root.AssemblyLinearVelocity.X,
                    launchPower,
                    root.AssemblyLinearVelocity.Z
                )

                local duration = (360 * spinCount) / math.max(spinSpeed, 1)
                local elapsed = 0

                while elapsed < duration
                    and activeTrick == mode
                    and trickToken == myToken
                    and root.Parent
                    and humanoid.Health > 0 do

                    local dt = RunService.RenderStepped:Wait()
                    elapsed += dt

                    local angle = math.rad(spinSpeed * elapsed)
                    root.CFrame = CFrame.new(root.Position)
                        * CFrame.Angles(0, angle, 0)
                end

            else
                -- FLOATING AIR SPIN
                local startCFrame = root.CFrame
                local startPosition = startCFrame.Position
                local originalRotation = startCFrame - startPosition

                local height = floatHeight
                local floatTime = 0.25
                local spinTime = (360 * spinCount) / math.max(spinSpeed, 1)
                local returnTime = 0.25
                local elapsed = 0

                -- Disable normal movement briefly so the float is smooth.
                local previousAutoRotate = humanoid.AutoRotate
                humanoid.AutoRotate = false

                -- Rise smoothly without jumping.
                while elapsed < floatTime
                    and activeTrick == mode
                    and trickToken == myToken
                    and root.Parent
                    and humanoid.Health > 0 do

                    local dt = RunService.RenderStepped:Wait()
                    elapsed += dt

                    local alpha = math.clamp(elapsed / floatTime, 0, 1)
                    local y = startPosition.Y + height * alpha

                    root.AssemblyLinearVelocity = Vector3.zero
                    root.CFrame = CFrame.new(
                        startPosition.X, y, startPosition.Z
                    ) * originalRotation
                end

                -- Spin fast while staying at the raised height.
                elapsed = 0
                while elapsed < spinTime
                    and activeTrick == mode
                    and trickToken == myToken
                    and root.Parent
                    and humanoid.Health > 0 do

                    local dt = RunService.RenderStepped:Wait()
                    elapsed += dt

                    local angle = math.rad(spinSpeed * elapsed)
                    local raisedPosition = Vector3.new(
                        startPosition.X,
                        startPosition.Y + height,
                        startPosition.Z
                    )

                    root.AssemblyLinearVelocity = Vector3.zero
                    root.CFrame = CFrame.new(raisedPosition)
                        * originalRotation
                        * CFrame.Angles(0, angle, 0)
                end

                -- Return smoothly to the exact starting height.
                elapsed = 0
                while elapsed < returnTime
                    and activeTrick == mode
                    and trickToken == myToken
                    and root.Parent
                    and humanoid.Health > 0 do

                    local dt = RunService.RenderStepped:Wait()
                    elapsed += dt

                    local alpha = math.clamp(elapsed / returnTime, 0, 1)
                    local y = startPosition.Y + height * (1 - alpha)

                    root.AssemblyLinearVelocity = Vector3.zero
                    root.CFrame = CFrame.new(
                        startPosition.X, y, startPosition.Z
                    ) * originalRotation
                end

                if humanoid.Parent then
                    humanoid.AutoRotate = previousAutoRotate
                end
            end

            if activeTrick == mode and trickToken == myToken then
                task.wait(0.1)
            end
        end
    end)
end

