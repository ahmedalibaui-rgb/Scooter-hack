-- Airspin: continuous forward flips while airborne.
RunService.Heartbeat:Connect(function(dt)
    local _, humanoid, root = getCharacterParts()
    if not humanoid or not root then
        spinning = false
        return
    end

    local airborne = humanoid.FloorMaterial == Enum.Material.Air
    spinning = airborne and (airspinEnabled or catapultEnabled)

    if spinning then
        root.CFrame = root.CFrame
            * CFrame.Angles(0, 0, math.rad(spinSpeed) * dt)
    end
end)

airButton.Activated:Connect(function()
    airspinEnabled = not airspinEnabled
    airButton.Text = airspinEnabled and "Airspin: ON" or "Airspin: OFF"
    notify(airButton.Text)
end)

catButton.Activated:Connect(function()
    catapultEnabled = not catapultEnabled
    catButton.Text = catapultEnabled and "Catapult: ON" or "Catapult: OFF"
    notify(catButton.Text)

    if not catapultEnabled then return end

    local _, humanoid, root = getCharacterParts()
    if not humanoid or not root then
        catapultEnabled = false
        catButton.Text = "Catapult: OFF"
        notify("Character not ready")
        return
    end

    humanoid:ChangeState(Enum.HumanoidStateType.Jumping)

    root.AssemblyLinearVelocity = Vector3.new(
        root.AssemblyLinearVelocity.X,
        launchPower,
        root.AssemblyLinearVelocity.Z
    )

    -- Automatically switch off after landing.
    task.spawn(function()
        local startTime = os.clock()
        while catapultEnabled and os.clock() - startTime < 8 do
            task.wait(0.1)
            local _, currentHumanoid = getCharacterParts()
            if currentHumanoid
                and currentHumanoid.FloorMaterial ~= Enum.Material.Air
                and os.clock() - startTime > 0.4 then
                break
            end
        end

        catapultEnabled = false
        catButton.Text = "Catapult: OFF"
    end)
end)

songButton.Activated:Connect(function()
